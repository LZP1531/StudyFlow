{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "noEmit": false
  },
  "include": [
    "electron/**/*.ts",
    "electron/types/**/*.d.ts",
    "src/types/**/*.ts",
    "src/data/mockStudyData.ts"
  ]
}
